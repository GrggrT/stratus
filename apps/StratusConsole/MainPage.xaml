<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="StratusConsole.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:StratusConsole.Models"
    xmlns:converters="using:StratusConsole.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:AccentToBrushConverter x:Key="AccentToBrush" />
        <Style x:Key="StatusCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="MinHeight" Value="142" />
        </Style>
        <Style x:Key="CockpitCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <DataTemplate x:Key="CommandPaletteActionTemplate">
            <Border
                Padding="12,10"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid ColumnSpacing="12" RowSpacing="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap" />
                    <Border
                        Grid.Column="1"
                        Padding="8,2"
                        VerticalAlignment="Top"
                        Background="{Binding Accent, Converter={StaticResource AccentToBrush}}"
                        CornerRadius="8">
                        <TextBlock FontSize="11" Text="{Binding Status}" />
                    </Border>
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" FontSize="12" Text="{Binding Subtitle}" TextWrapping="Wrap" />
                    <TextBlock
                        Grid.Row="2"
                        Grid.ColumnSpan="2"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{Binding Detail}"
                        TextWrapping="Wrap" />
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator
            Key="K"
            Modifiers="Control"
            Invoked="CommandPaletteKeyboardAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <NavigationView
        x:Name="RootNavigation"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="True"
        OpenPaneLength="280"
        PaneDisplayMode="Auto"
        PaneTitle="STRATUS"
        SelectionChanged="RootNavigation_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="Cockpit" Tag="Dashboard">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Markets" Tag="Markets">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE8EF;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Signals" Tag="Signals">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D2;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Positions" Tag="Positions">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE8C7;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Calibration" Tag="Calibration">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Jobs" Tag="Jobs">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE9F5;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem
                x:Name="AlertsNavigationItem"
                AutomationProperties.Name="Alerts"
                Content="Alerts"
                Tag="Alerts">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE7F4;" /></NavigationViewItem.Icon>
                <NavigationViewItem.InfoBadge>
                    <InfoBadge
                        x:Name="AlertsInfoBadge"
                        Value="0"
                        Visibility="Collapsed" />
                </NavigationViewItem.InfoBadge>
            </NavigationViewItem>
            <NavigationViewItem Content="Live" Tag="Live">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE945;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Operations" Tag="Operations">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <Grid
            x:Name="ContentRoot"
            HorizontalAlignment="Left"
            SizeChanged="ContentRoot_SizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid x:Name="HeaderGrid" Padding="32,24,24,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup>
                        <VisualState x:Name="CompactHeader" />
                        <VisualState x:Name="WideHeader">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="1700" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="PageCommandBar.(Grid.Row)" Value="0" />
                                <Setter Target="PageCommandBar.(Grid.Column)" Value="1" />
                                <Setter Target="PageCommandBar.(Grid.ColumnSpan)" Value="1" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <StackPanel Spacing="4">
                    <TextBlock x:Name="PageTitle" FontSize="28" FontWeight="SemiBold" Text="System overview" />
                    <TextBlock
                        x:Name="PageSubtitle"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Live read-only monitoring from the local STRATUS API"
                        TextWrapping="Wrap" />
                </StackPanel>
                <CommandBar
                    x:Name="PageCommandBar"
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Background="Transparent"
                    DefaultLabelPosition="Right"
                    HorizontalAlignment="Left"
                    IsDynamicOverflowEnabled="True">
                    <AppBarButton
                        x:Name="StopButton"
                        Click="StopButton_Click"
                        Label="Stop">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE71A;" /></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton
                        x:Name="ResumeButton"
                        Click="ResumeButton_Click"
                        Label="Resume"
                        Visibility="Collapsed">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE768;" /></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton
                        x:Name="VerifyMarketButton"
                        Click="VerifyMarketButton_Click"
                        Label="Verify market"
                        Visibility="Collapsed">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE73E;" /></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton
                        x:Name="RunJobButton"
                        Click="RunJobButton_Click"
                        Label="Run job"
                        Visibility="Collapsed">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE9F5;" /></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton
                        x:Name="PaperModeButton"
                        Click="PaperModeButton_Click"
                        Label="Paper mode"
                        Visibility="Collapsed">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE8A5;" /></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton
                        x:Name="LiveModeButton"
                        Click="LiveModeButton_Click"
                        Label="Live mode"
                        Visibility="Collapsed">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE945;" /></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarElementContainer
                        x:Name="PositionsFilterContainer"
                        VerticalContentAlignment="Center"
                        Visibility="Collapsed">
                        <ComboBox
                            x:Name="PositionsFilterBox"
                            MinWidth="110"
                            SelectedIndex="0"
                            SelectionChanged="PositionsFilterBox_SelectionChanged">
                            <ComboBoxItem Content="Open" />
                            <ComboBoxItem Content="Closed" />
                            <ComboBoxItem Content="All" />
                        </ComboBox>
                    </AppBarElementContainer>
                    <AppBarElementContainer
                        x:Name="SignalsFilterContainer"
                        VerticalContentAlignment="Center"
                        Visibility="Collapsed">
                        <ComboBox
                            x:Name="SignalsFilterBox"
                            MinWidth="130"
                            SelectedIndex="3"
                            SelectionChanged="SignalsFilterBox_SelectionChanged">
                            <ComboBoxItem Content="Actionable" />
                            <ComboBoxItem Content="Skipped" />
                            <ComboBoxItem Content="A+B" />
                            <ComboBoxItem Content="All" />
                        </ComboBox>
                    </AppBarElementContainer>
                    <AppBarElementContainer
                        x:Name="MarketsFilterContainer"
                        VerticalContentAlignment="Center"
                        Visibility="Collapsed">
                        <ComboBox
                            x:Name="MarketsFilterBox"
                            MinWidth="140"
                            SelectedIndex="0"
                            SelectionChanged="MarketsFilterBox_SelectionChanged">
                            <ComboBoxItem Content="Active" />
                            <ComboBoxItem Content="Resolving soon" />
                            <ComboBoxItem Content="Needs verify" />
                            <ComboBoxItem Content="Blocked" />
                            <ComboBoxItem Content="All" />
                        </ComboBox>
                    </AppBarElementContainer>
                    <AppBarElementContainer
                        x:Name="CalibrationFilterContainer"
                        VerticalContentAlignment="Center"
                        Visibility="Collapsed">
                        <ComboBox
                            x:Name="CalibrationFilterBox"
                            MinWidth="130"
                            SelectedIndex="0"
                            SelectionChanged="CalibrationFilterBox_SelectionChanged">
                            <ComboBoxItem Content="All" />
                            <ComboBoxItem Content="Mature" />
                            <ComboBoxItem Content="Needs data" />
                            <ComboBoxItem Content="Review risk" />
                        </ComboBox>
                    </AppBarElementContainer>
                    <AppBarElementContainer
                        x:Name="JobsFilterContainer"
                        VerticalContentAlignment="Center"
                        Visibility="Collapsed">
                        <ComboBox
                            x:Name="JobsFilterBox"
                            MinWidth="130"
                            SelectedIndex="0"
                            SelectionChanged="JobsFilterBox_SelectionChanged">
                            <ComboBoxItem Content="All" />
                            <ComboBoxItem Content="Failures" />
                            <ComboBoxItem Content="Slow" />
                            <ComboBoxItem Content="Prices" />
                            <ComboBoxItem Content="Execution" />
                        </ComboBox>
                    </AppBarElementContainer>
                    <AppBarElementContainer
                        x:Name="AlertsFilterContainer"
                        VerticalContentAlignment="Center"
                        Visibility="Collapsed">
                        <ComboBox
                            x:Name="AlertsFilterBox"
                            AutomationProperties.Name="Alert inbox filter"
                            MinWidth="170"
                            SelectedIndex="0"
                            SelectionChanged="AlertsFilterBox_SelectionChanged">
                            <ComboBoxItem Content="Unacknowledged" />
                            <ComboBoxItem Content="All alerts" />
                        </ComboBox>
                    </AppBarElementContainer>
                    <AppBarButton
                        x:Name="AlertsAckThroughButton"
                        AutomationProperties.HelpText="Acknowledge every local alert through the newest unacknowledged id shown in the current view."
                        Click="AlertsAckThroughButton_Click"
                        IsEnabled="False"
                        Label="Ack visible through newest"
                        Visibility="Collapsed">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE73E;" /></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarElementContainer
                        x:Name="CollectionSearchContainer"
                        VerticalContentAlignment="Center"
                        Visibility="Collapsed">
                        <TextBox
                            x:Name="CollectionSearchBox"
                            Width="220"
                            PlaceholderText="Search current list"
                            TextChanged="CollectionSearchBox_TextChanged" />
                    </AppBarElementContainer>
                    <AppBarButton
                        x:Name="ApiKeyButton"
                        Click="ApiKeyButton_Click"
                        Label="API key"
                        Visibility="Collapsed">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE72E;" /></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarSeparator />
                    <AppBarButton
                        x:Name="CommandPaletteButton"
                        AutomationProperties.Name="Command palette Ctrl K"
                        Click="CommandPaletteButton_Click"
                        Label="Palette">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE721;" /></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton
                        x:Name="RefreshButton"
                        Click="RefreshButton_Click"
                        Icon="Refresh"
                        Label="Refresh" />
                    <AppBarToggleButton
                        x:Name="AutoRefreshButton"
                        Icon="Sync"
                        IsChecked="True"
                        Label="Auto refresh" />
                </CommandBar>
            </Grid>

            <InfoBar
                x:Name="SystemInfoBar"
                Grid.Row="1"
                Margin="32,0,32,16"
                IsClosable="False"
                IsOpen="True"
                Message="Contacting http://127.0.0.1:8000"
                Severity="Informational"
                Title="Connecting" />

            <ScrollViewer
                x:Name="DashboardView"
                Grid.Row="2"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled">
                <StackPanel
                    x:Name="DashboardContent"
                    MaxWidth="1500"
                    Padding="32,0,32,40"
                    HorizontalAlignment="Left"
                    Spacing="16">
                    <Grid
                        x:Name="CockpitSummaryGrid"
                        ColumnSpacing="12"
                        RowSpacing="12">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CockpitSummaryLayoutStates">
                                <VisualState x:Name="CockpitSummaryWide">
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="1600" />
                                    </VisualState.StateTriggers>
                                    <VisualState.Setters>
                                        <Setter Target="CockpitSummaryColumn2.Width" Value="*" />
                                        <Setter Target="CockpitSummaryColumn3.Width" Value="*" />
                                        <Setter Target="CockpitSummaryColumn4.Width" Value="*" />
                                        <Setter Target="CockpitSummaryUnrealizedCard.(Grid.Row)" Value="0" />
                                        <Setter Target="CockpitSummaryUnrealizedCard.(Grid.Column)" Value="2" />
                                        <Setter Target="CockpitSummaryExposureCard.(Grid.Row)" Value="0" />
                                        <Setter Target="CockpitSummaryExposureCard.(Grid.Column)" Value="3" />
                                        <Setter Target="CockpitSummaryGateCard.(Grid.Row)" Value="0" />
                                        <Setter Target="CockpitSummaryGateCard.(Grid.Column)" Value="4" />
                                        <Setter Target="CockpitSummaryGateCard.(Grid.ColumnSpan)" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CockpitSummaryMedium">
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="1200" />
                                    </VisualState.StateTriggers>
                                    <VisualState.Setters>
                                        <Setter Target="CockpitSummaryColumn2.Width" Value="*" />
                                        <Setter Target="CockpitSummaryUnrealizedCard.(Grid.Row)" Value="0" />
                                        <Setter Target="CockpitSummaryUnrealizedCard.(Grid.Column)" Value="2" />
                                        <Setter Target="CockpitSummaryExposureCard.(Grid.Row)" Value="1" />
                                        <Setter Target="CockpitSummaryExposureCard.(Grid.Column)" Value="0" />
                                        <Setter Target="CockpitSummaryGateCard.(Grid.Row)" Value="1" />
                                        <Setter Target="CockpitSummaryGateCard.(Grid.Column)" Value="1" />
                                        <Setter Target="CockpitSummaryGateCard.(Grid.ColumnSpan)" Value="2" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CockpitSummaryCompact">
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="0" />
                                    </VisualState.StateTriggers>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="CockpitSummaryColumn0" Width="*" />
                            <ColumnDefinition x:Name="CockpitSummaryColumn1" Width="*" />
                            <ColumnDefinition x:Name="CockpitSummaryColumn2" Width="0" />
                            <ColumnDefinition x:Name="CockpitSummaryColumn3" Width="0" />
                            <ColumnDefinition x:Name="CockpitSummaryColumn4" Width="0" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource CockpitCardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Runtime" />
                                <TextBlock x:Name="RuntimeStatusText" FontSize="22" FontWeight="SemiBold" Text="Unknown" />
                                <TextBlock
                                    x:Name="RuntimeDetailText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Waiting for /api/v1/overview"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource CockpitCardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Bankroll" />
                                <TextBlock x:Name="PortfolioStatusText" FontSize="22" FontWeight="SemiBold" Text="—" />
                                <TextBlock
                                    x:Name="PortfolioDetailText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Balance and exposure unavailable"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border
                            x:Name="CockpitSummaryUnrealizedCard"
                            Grid.Row="1"
                            Style="{StaticResource CockpitCardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Unrealized P&amp;L" />
                                <TextBlock x:Name="CockpitUnrealizedText" FontSize="22" FontWeight="SemiBold" Text="—" />
                                <TextBlock
                                    x:Name="CockpitUnrealizedDetailText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="No open mark-to-market yet"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="CockpitLiquidationText"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Liquidation P&amp;L —"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="CockpitMarkMovesText"
                                    FontFamily="Consolas"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="Δ1m — · Δ5m — · Δ60m —"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="CockpitMarkFreshnessText"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="Last mark —"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border
                            x:Name="CockpitSummaryExposureCard"
                            Grid.Row="1"
                            Grid.Column="1"
                            Style="{StaticResource CockpitCardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Open exposure" />
                                <TextBlock x:Name="CockpitExposureText" FontSize="22" FontWeight="SemiBold" Text="—" />
                                <TextBlock
                                    x:Name="CockpitExposureDetailText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="No open exposure"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border
                            x:Name="CockpitSummaryGateCard"
                            Grid.Row="2"
                            Grid.ColumnSpan="2"
                            Style="{StaticResource CockpitCardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Prospective validation gate"
                                    ToolTipService.ToolTip="Only immutable dual-token CLOB evidence collected after the protocol cutover can pass this gate." />
                                <TextBlock x:Name="GateStatusText" FontSize="22" FontWeight="SemiBold" Text="Not evaluated" />
                                <TextBlock
                                    x:Name="GateDetailText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Waiting for a validation checkpoint"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource CockpitCardStyle}">
                        <StackPanel Spacing="14">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Edge validation" />
                                    <TextBlock
                                        x:Name="EdgeGateSubtitle"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Is the paper edge real, or luck? Live mode stays blocked until every check passes."
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        x:Name="EdgeProtocolText"
                                        AutomationProperties.HelpText="The live gate restarts from zero and excludes legacy synthetic YES-price evidence."
                                        FontSize="12"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Text="Prospective dual-token · new evidence cohort"
                                        TextWrapping="Wrap"
                                        ToolTipService.ToolTip="clob-dual-v1 uses independently captured YES and NO books. Legacy trades remain visible in portfolio history but do not count toward this gate." />
                                </StackPanel>
                                <Border
                                    x:Name="EdgeGateBadge"
                                    Grid.Column="1"
                                    Padding="12,5"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                                    CornerRadius="10">
                                    <TextBlock x:Name="EdgeGateBadgeText" FontWeight="SemiBold" Text="—" />
                                </Border>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="28">
                                <StackPanel Spacing="2">
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Skill P&amp;L" />
                                    <TextBlock x:Name="EdgeSkillText" FontSize="20" FontWeight="SemiBold" Text="—" />
                                </StackPanel>
                                <StackPanel Spacing="2">
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Luck P&amp;L" />
                                    <TextBlock x:Name="EdgeLuckText" FontSize="20" FontWeight="SemiBold" Text="—" />
                                </StackPanel>
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Prospective Brier vs market"
                                        ToolTipService.ToolTip="Computed only from resolved clob-dual-v1 trades on the current model cohort." />
                                    <TextBlock x:Name="EdgeBrierText" FontSize="20" FontWeight="SemiBold" Text="—" />
                                </StackPanel>
                                <StackPanel Spacing="2">
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="ROI 95% CI" />
                                    <TextBlock x:Name="EdgeCiText" FontSize="20" FontWeight="SemiBold" Text="—" />
                                </StackPanel>
                            </StackPanel>
                            <ItemsControl x:Name="EdgeChecklistItems">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:MonitoringListItem">
                                        <Grid Margin="0,0,0,6" ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border
                                                Width="10"
                                                Height="10"
                                                VerticalAlignment="Center"
                                                Background="{x:Bind Accent, Converter={StaticResource AccentToBrush}}"
                                                CornerRadius="5" />
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind Title}" TextWrapping="Wrap" />
                                            <TextBlock
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind Detail}"
                                                TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border
                        Style="{StaticResource CockpitCardStyle}"
                        AutomationProperties.Name="Prospective evidence clock">
                        <StackPanel Spacing="16">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3">
                                    <TextBlock
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        Text="Prospective evidence clock" />
                                    <TextBlock
                                        x:Name="EvidenceClockSubtitle"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="One frozen probability cohort, followed from materialization through independent resolved outcomes."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <Border
                                    x:Name="EvidenceClockBadge"
                                    Grid.Column="1"
                                    Padding="12,5"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                                    CornerRadius="10">
                                    <TextBlock
                                        x:Name="EvidenceClockBadgeText"
                                        AutomationProperties.LiveSetting="Polite"
                                        Foreground="#FF111827"
                                        FontWeight="SemiBold"
                                        Text="LOADING" />
                                </Border>
                            </Grid>

                            <Border
                                Padding="14,12"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <Grid ColumnSpacing="22" RowSpacing="8">
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="EvidenceClockIdentityStates">
                                            <VisualState x:Name="EvidenceClockIdentityCompact" />
