                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="Operator setup center" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Local API, credential source, runtime mode, and data-safety posture"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock
                                x:Name="SettingsCenterSummaryText"
                                Grid.Column="1"
                                VerticalAlignment="Top"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="No setup data"
                                TextWrapping="Wrap" />
                        </Grid>
                        <Grid Grid.Row="1" ColumnSpacing="12" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border
                                Padding="12"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <StackPanel Spacing="8">
                                    <TextBlock FontWeight="SemiBold" Text="Local API" />
                                    <TextBlock x:Name="SettingsApiText" FontSize="15" Text="No API data loaded" TextWrapping="Wrap" />
                                    <TextBlock
                                        x:Name="SettingsApiDetailText"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="No API detail loaded"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border
                                Grid.Column="1"
                                Padding="12"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <StackPanel Spacing="8">
                                    <TextBlock FontWeight="SemiBold" Text="Operator credential" />
                                    <TextBlock x:Name="SettingsCredentialText" FontSize="15" Text="No credential data loaded" TextWrapping="Wrap" />
                                    <TextBlock
                                        x:Name="SettingsCredentialDetailText"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Use API key in the command bar"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border
                                Grid.Row="1"
                                Padding="12"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <StackPanel Spacing="8">
                                    <TextBlock FontWeight="SemiBold" Text="Runtime target" />
                                    <TextBlock x:Name="SettingsRuntimeText" FontSize="15" Text="No runtime data loaded" TextWrapping="Wrap" />
                                    <TextBlock
                                        x:Name="SettingsRuntimeDetailText"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Runtime detail unavailable"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border
                                Grid.Row="1"
                                Grid.Column="1"
                                Padding="12"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <StackPanel Spacing="8">
                                    <TextBlock FontWeight="SemiBold" Text="Setup checklist" />
                                    <TextBlock
                                        x:Name="SettingsChecklistText"
                                        FontFamily="Consolas"
                                        FontSize="13"
                                        Text="No setup checklist loaded"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
                <Border
                    x:Name="PortfolioAnalyticsPanel"
                    Grid.Row="0"
                    Grid.ColumnSpan="2"
                    Margin="32,0,32,12"
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Visibility="Collapsed">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Portfolio analytics" />
                            <TextBlock
                                x:Name="PortfolioAnalyticsSubtitle"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Open exposure, realised equity, and mark-to-market risk"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Grid Grid.Row="1" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.35*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Padding="12"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <Grid RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="220" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Text="Equity and open P&amp;L" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="Realised curve plus current unrealised mark"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Canvas
                                        x:Name="PortfolioEquityCanvas"
                                        Grid.Row="1"
                                        SizeChanged="PortfolioEquityCanvas_SizeChanged" />
                                    <TextBlock
                                        x:Name="PortfolioEquitySummaryText"
                                        Grid.Row="2"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="No portfolio series loaded"
                                        TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                            <Border
                                Grid.Column="1"
                                Padding="12"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <Grid RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="220" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Text="Exposure heatmap" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="Station × date open cost, coloured by unrealised P&amp;L"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Canvas
                                        x:Name="PortfolioExposureCanvas"
                                        Grid.Row="1"
                                        SizeChanged="PortfolioExposureCanvas_SizeChanged" />
                                    <TextBlock
                                        x:Name="PortfolioExposureSummaryText"
                                        Grid.Row="2"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="No open exposure"
                                        TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
                <Border
                    x:Name="EquityChartCard"
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Margin="32,0,32,12"
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="Collapsed">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="EquityChartTitle" FontWeight="SemiBold" Text="Live realised equity" />
                        <Canvas x:Name="EquityCanvas" Height="200" SizeChanged="EquityCanvas_SizeChanged" />
                    </StackPanel>
                </Border>
                <ListView
                    x:Name="CollectionList"
                    Grid.Row="2"
                    Padding="32,0,32,32"
                    IsItemClickEnabled="True"
                    ItemClick="CollectionList_ItemClick"
                    SelectionMode="Single"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.HorizontalScrollMode="Disabled">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,6" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:MonitoringListItem">
                            <Border
                                Padding="14,10"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <Grid ColumnSpacing="12" RowSpacing="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock FontSize="15" FontWeight="SemiBold" Text="{x:Bind Title}" TextWrapping="Wrap" />
                                    <Border
                                        Grid.Column="1"
                                        Padding="8,2"
                                        VerticalAlignment="Top"
                                        Background="{x:Bind Accent, Converter={StaticResource AccentToBrush}}"
                                        CornerRadius="10">
                                        <TextBlock FontSize="11" Text="{x:Bind Status}" />
                                    </Border>
                                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" FontSize="13" Text="{x:Bind Subtitle}" TextWrapping="Wrap" />
                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.ColumnSpan="2"
                                        FontSize="13"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind Detail}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Grid.Row="3"
                                        Grid.ColumnSpan="2"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Text="{x:Bind Meta}"
                                        TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel
                    x:Name="CollectionEmptyState"
                    Grid.Row="1"
                    Grid.Column="0"
                    MaxWidth="520"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="10">
                    <FontIcon FontSize="36" Glyph="&#xE90F;" />
                    <TextBlock
                        x:Name="CollectionEmptyText"
                        FontSize="18"
                        Text="No records yet"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>

                <Border
                    x:Name="MarketDrilldownPanel"
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="0,0,32,32"
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Visibility="Collapsed">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="190" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Market drill-down" />
                            <TextBlock
                                x:Name="DrilldownTitle"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Select a market, signal, or position"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox
                            x:Name="DrilldownSeriesBox"
                            Grid.Row="1"
                            MinWidth="180"
                            SelectedIndex="0"
                            SelectionChanged="DrilldownSeriesBox_SelectionChanged">
                            <ComboBoxItem Content="Price" />
                            <ComboBoxItem Content="Probability" />
                            <ComboBoxItem Content="Edge" />
                        </ComboBox>
                        <Canvas
                            x:Name="DrilldownChartCanvas"
                            Grid.Row="2"
                            AutomationProperties.Name="Interactive market drill-down chart"
                            Background="Transparent"
                            PointerEntered="DrilldownChartCanvas_PointerMoved"
                            PointerExited="DrilldownChartCanvas_PointerExited"
                            PointerMoved="DrilldownChartCanvas_PointerMoved"
                            SizeChanged="DrilldownChartCanvas_SizeChanged" />
                        <StackPanel Grid.Row="3" Spacing="4">
                            <TextBlock x:Name="DrilldownSummaryText" Text="No market selected" TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="DrilldownMetaText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Chart and orderbook will load after selection"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Grid Grid.Row="4" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock FontWeight="SemiBold" Text="Bids" />
                                <TextBlock
                                    x:Name="OrderBookBidsText"
                                    FontFamily="Consolas"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="—"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock FontWeight="SemiBold" Text="Asks" />
                                <TextBlock
                                    x:Name="OrderBookAsksText"
                                    FontFamily="Consolas"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="—"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </NavigationView>
</Page>
