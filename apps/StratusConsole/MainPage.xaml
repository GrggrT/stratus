<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="StratusConsole.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:StratusConsole.Models"
    xmlns:converters="using:StratusConsole.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:AccentToBrushConverter x:Key="AccentToBrush" />
        <Style x:Key="StatusCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="MinHeight" Value="142" />
        </Style>
        <Style x:Key="CockpitCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <DataTemplate x:Key="CommandPaletteActionTemplate">
            <Border
                Padding="12,10"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid ColumnSpacing="12" RowSpacing="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap" />
                    <Border
                        Grid.Column="1"
                        Padding="8,2"
                        VerticalAlignment="Top"
                        Background="{Binding Accent, Converter={StaticResource AccentToBrush}}"
                        CornerRadius="8">
                        <TextBlock FontSize="11" Text="{Binding Status}" />
                    </Border>
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" FontSize="12" Text="{Binding Subtitle}" TextWrapping="Wrap" />
                    <TextBlock
                        Grid.Row="2"
                        Grid.ColumnSpan="2"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{Binding Detail}"
                        TextWrapping="Wrap" />
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator
            Key="K"
            Modifiers="Control"
            Invoked="CommandPaletteKeyboardAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <NavigationView
        x:Name="RootNavigation"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="True"
        OpenPaneLength="280"
        PaneDisplayMode="Auto"
        PaneTitle="STRATUS"
        SelectionChanged="RootNavigation_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="Cockpit" Tag="Dashboard">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Markets" Tag="Markets">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE8EF;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Signals" Tag="Signals">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D2;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Positions" Tag="Positions">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE8C7;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Calibration" Tag="Calibration">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Jobs" Tag="Jobs">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE9F5;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Live" Tag="Live">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE945;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Operations" Tag="Operations">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <Grid x:Name="ContentRoot" SizeChanged="ContentRoot_SizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid x:Name="HeaderGrid" Padding="32,24,24,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup>
                        <VisualState x:Name="CompactHeader" />
                        <VisualState x:Name="WideHeader">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="1700" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="PageCommandBar.(Grid.Row)" Value="0" />
                                <Setter Target="PageCommandBar.(Grid.Column)" Value="1" />
                                <Setter Target="PageCommandBar.(Grid.ColumnSpan)" Value="1" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <StackPanel Spacing="4">
                    <TextBlock x:Name="PageTitle" FontSize="28" FontWeight="SemiBold" Text="System overview" />
                    <TextBlock
                        x:Name="PageSubtitle"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Live read-only monitoring from the local STRATUS API"
                        TextWrapping="Wrap" />
                </StackPanel>
                <CommandBar
                    x:Name="PageCommandBar"
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Background="Transparent"
                    DefaultLabelPosition="Right"
                    HorizontalAlignment="Left"
                    IsDynamicOverflowEnabled="True">
                    <AppBarButton
                        x:Name="StopButton"
                        Click="StopButton_Click"
                        Label="Stop">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE71A;" /></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton
                        x:Name="ResumeButton"
                        Click="ResumeButton_Click"
                        Label="Resume"
                        Visibility="Collapsed">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE768;" /></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton
                        x:Name="VerifyMarketButton"
                        Click="VerifyMarketButton_Click"
                        Label="Verify market"
                        Visibility="Collapsed">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE73E;" /></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton
                        x:Name="RunJobButton"
                        Click="RunJobButton_Click"
                        Label="Run job"
                        Visibility="Collapsed">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE9F5;" /></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton
                        x:Name="PaperModeButton"
                        Click="PaperModeButton_Click"
                        Label="Paper mode"
                        Visibility="Collapsed">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE8A5;" /></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton
                        x:Name="LiveModeButton"
                        Click="LiveModeButton_Click"
                        Label="Live mode"
                        Visibility="Collapsed">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE945;" /></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarElementContainer
                        x:Name="PositionsFilterContainer"
                        VerticalContentAlignment="Center"
                        Visibility="Collapsed">
                        <ComboBox
                            x:Name="PositionsFilterBox"
                            MinWidth="110"
                            SelectedIndex="0"
                            SelectionChanged="PositionsFilterBox_SelectionChanged">
                            <ComboBoxItem Content="Open" />
                            <ComboBoxItem Content="Closed" />
                            <ComboBoxItem Content="All" />
                        </ComboBox>
                    </AppBarElementContainer>
                    <AppBarElementContainer
                        x:Name="SignalsFilterContainer"
                        VerticalContentAlignment="Center"
                        Visibility="Collapsed">
                        <ComboBox
                            x:Name="SignalsFilterBox"
                            MinWidth="130"
                            SelectedIndex="3"
                            SelectionChanged="SignalsFilterBox_SelectionChanged">
                            <ComboBoxItem Content="Actionable" />
                            <ComboBoxItem Content="Skipped" />
                            <ComboBoxItem Content="A+B" />
                            <ComboBoxItem Content="All" />
                        </ComboBox>
                    </AppBarElementContainer>
                    <AppBarElementContainer
                        x:Name="MarketsFilterContainer"
                        VerticalContentAlignment="Center"
                        Visibility="Collapsed">
                        <ComboBox
                            x:Name="MarketsFilterBox"
                            MinWidth="140"
                            SelectedIndex="0"
                            SelectionChanged="MarketsFilterBox_SelectionChanged">
                            <ComboBoxItem Content="Active" />
                            <ComboBoxItem Content="Resolving soon" />
                            <ComboBoxItem Content="Needs verify" />
                            <ComboBoxItem Content="Blocked" />
                            <ComboBoxItem Content="All" />
                        </ComboBox>
                    </AppBarElementContainer>
                    <AppBarElementContainer
                        x:Name="CalibrationFilterContainer"
                        VerticalContentAlignment="Center"
                        Visibility="Collapsed">
                        <ComboBox
                            x:Name="CalibrationFilterBox"
                            MinWidth="130"
                            SelectedIndex="0"
                            SelectionChanged="CalibrationFilterBox_SelectionChanged">
                            <ComboBoxItem Content="All" />
                            <ComboBoxItem Content="Mature" />
                            <ComboBoxItem Content="Needs data" />
                            <ComboBoxItem Content="Review risk" />
                        </ComboBox>
                    </AppBarElementContainer>
                    <AppBarElementContainer
                        x:Name="JobsFilterContainer"
                        VerticalContentAlignment="Center"
                        Visibility="Collapsed">
                        <ComboBox
                            x:Name="JobsFilterBox"
                            MinWidth="130"
                            SelectedIndex="0"
                            SelectionChanged="JobsFilterBox_SelectionChanged">
                            <ComboBoxItem Content="All" />
                            <ComboBoxItem Content="Failures" />
                            <ComboBoxItem Content="Slow" />
                            <ComboBoxItem Content="Prices" />
                            <ComboBoxItem Content="Execution" />
                        </ComboBox>
                    </AppBarElementContainer>
                    <AppBarElementContainer
                        x:Name="CollectionSearchContainer"
                        VerticalContentAlignment="Center"
                        Visibility="Collapsed">
                        <TextBox
                            x:Name="CollectionSearchBox"
                            Width="220"
                            PlaceholderText="Search current list"
                            TextChanged="CollectionSearchBox_TextChanged" />
                    </AppBarElementContainer>
                    <AppBarButton
                        x:Name="ApiKeyButton"
                        Click="ApiKeyButton_Click"
                        Label="API key"
                        Visibility="Collapsed">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE72E;" /></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarSeparator />
                    <AppBarButton
                        x:Name="CommandPaletteButton"
                        AutomationProperties.Name="Command palette Ctrl K"
                        Click="CommandPaletteButton_Click"
                        Label="Palette">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE721;" /></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton
                        x:Name="RefreshButton"
                        Click="RefreshButton_Click"
                        Icon="Refresh"
                        Label="Refresh" />
                    <AppBarToggleButton
                        x:Name="AutoRefreshButton"
                        Icon="Sync"
                        IsChecked="True"
                        Label="Auto refresh" />
                </CommandBar>
            </Grid>

            <InfoBar
                x:Name="SystemInfoBar"
                Grid.Row="1"
                Margin="32,0,32,16"
                IsClosable="False"
                IsOpen="True"
                Message="Contacting http://127.0.0.1:8000"
                Severity="Informational"
                Title="Connecting" />

            <ScrollViewer
                x:Name="DashboardView"
                Grid.Row="2"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                SizeChanged="DashboardView_SizeChanged">
                <StackPanel
                    x:Name="DashboardContent"
                    MaxWidth="1500"
                    Padding="32,0,32,40"
                    HorizontalAlignment="Left"
                    Spacing="16">
                    <Grid ColumnSpacing="12" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource CockpitCardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Runtime" />
                                <TextBlock x:Name="RuntimeStatusText" FontSize="22" FontWeight="SemiBold" Text="Unknown" />
                                <TextBlock
                                    x:Name="RuntimeDetailText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Waiting for /api/v1/overview"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource CockpitCardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Bankroll" />
                                <TextBlock x:Name="PortfolioStatusText" FontSize="22" FontWeight="SemiBold" Text="—" />
                                <TextBlock
                                    x:Name="PortfolioDetailText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Balance and exposure unavailable"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource CockpitCardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Unrealized P&amp;L" />
                                <TextBlock x:Name="CockpitUnrealizedText" FontSize="22" FontWeight="SemiBold" Text="—" />
                                <TextBlock
                                    x:Name="CockpitUnrealizedDetailText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="No open mark-to-market yet"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Style="{StaticResource CockpitCardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Open exposure" />
                                <TextBlock x:Name="CockpitExposureText" FontSize="22" FontWeight="SemiBold" Text="—" />
                                <TextBlock
                                    x:Name="CockpitExposureDetailText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="No open exposure"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="4" Style="{StaticResource CockpitCardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Validation gate" />
                                <TextBlock x:Name="GateStatusText" FontSize="22" FontWeight="SemiBold" Text="Not evaluated" />
                                <TextBlock
                                    x:Name="GateDetailText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Waiting for a validation checkpoint"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid ColumnSpacing="16" RowSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.2*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource CockpitCardStyle}">
                            <Grid RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="280" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock x:Name="CockpitChartTitle" FontSize="20" FontWeight="SemiBold" Text="Paper equity and open P&amp;L" />
                                        <TextBlock
                                            x:Name="CockpitChartSubtitle"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="Realised curve when available; otherwise open mark-to-market distribution"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="13" Glyph="&#xE9D2;" />
                                        <TextBlock x:Name="CockpitLegendText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Signals · Fills · Risk" />
                                    </StackPanel>
                                </Grid>
                                <Canvas
                                    x:Name="CockpitChartCanvas"
                                    Grid.Row="1"
                                    SizeChanged="CockpitChartCanvas_SizeChanged" />
                                <TextBlock
                                    x:Name="ActivityText"
                                    Grid.Row="2"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Waiting for monitoring data"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource CockpitCardStyle}">
                            <StackPanel Spacing="12">
                                <StackPanel>
                                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Selected context" />
                                    <TextBlock
                                        x:Name="CockpitDetailHint"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Click a scanner row to inspect the signal or position."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <Border
                                    x:Name="CockpitDetailStatusBadge"
                                    Padding="10,4"
                                    HorizontalAlignment="Left"
                                    Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                                    CornerRadius="10">
                                    <TextBlock x:Name="CockpitDetailStatusTag" FontSize="12" Text="Idle" />
                                </Border>
                                <TextBlock x:Name="CockpitDetailTitle" FontSize="20" FontWeight="SemiBold" Text="No selection" TextWrapping="Wrap" />
                                <TextBlock x:Name="CockpitDetailPrimary" FontSize="15" Text="Select a market signal, open position, or risk event." TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="CockpitDetailSecondary"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="The panel will show model-vs-market context, sizing, P&amp;L, and skip rationale."
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="CockpitDetailMeta"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="No market selected"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource CockpitCardStyle}">
                            <Grid RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="360" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Opportunity scanner" />
                                        <TextBlock
                                            x:Name="CockpitScannerSubtitle"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="Recent signal edges and active mark-to-market positions"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock
                                        x:Name="UpdatedStatusText"
                                        HorizontalAlignment="Right"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="No successful refresh yet" />
                                </Grid>
                                <ListView
                                    x:Name="CockpitScannerList"
                                    Grid.Row="1"
                                    IsItemClickEnabled="True"
                                    ItemClick="CockpitScannerList_ItemClick"
                                    SelectionMode="Single"
                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                    ScrollViewer.HorizontalScrollMode="Disabled">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0,0,0,6" />
                                            <Setter Property="MinHeight" Value="0" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:MonitoringListItem">
                                            <Border
                                                Padding="12,9"
                                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="2">
                                                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="{x:Bind Title}" TextWrapping="Wrap" />
                                                        <TextBlock FontSize="12" Text="{x:Bind Subtitle}" TextWrapping="Wrap" />
                                                        <TextBlock
                                                            FontSize="12"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="{x:Bind Detail}"
                                                            TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <Border
                                                        Grid.Column="1"
                                                        Padding="8,2"
                                                        VerticalAlignment="Top"
                                                        Background="{x:Bind Accent, Converter={StaticResource AccentToBrush}}"
                                                        CornerRadius="10">
                                                        <TextBlock FontSize="11" Text="{x:Bind Status}" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CockpitCardStyle}">
                            <Grid RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="Risk rail" />
                                <StackPanel Grid.Row="1" Spacing="6">
                                    <TextBlock x:Name="ApiStatusText" FontSize="16" FontWeight="SemiBold" Text="Connecting" />
                                    <TextBlock x:Name="ApiDetailText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Waiting for health checks" TextWrapping="Wrap" />
                                    <TextBlock x:Name="CockpitRiskRuntime" Text="Runtime state unavailable" TextWrapping="Wrap" />
                                    <TextBlock x:Name="CockpitRiskHealth" Text="Health audit unavailable" TextWrapping="Wrap" />
                                    <TextBlock x:Name="CockpitRiskActivity" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="No recent activity" TextWrapping="Wrap" />
                                </StackPanel>
                                <Rectangle Grid.Row="2" Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                                <Grid Grid.Row="3">
                                    <StackPanel Spacing="8">
                                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Activity feed" />
                                        <TextBlock
                                            x:Name="CockpitActivitySubtitle"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="Latest commands, jobs, signals, and position changes"
                                            TextWrapping="Wrap" />
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox
                                                x:Name="CockpitActivityFilterBox"
                                                AutomationProperties.Name="Activity feed category"
                                                SelectedIndex="0"
                                                SelectionChanged="CockpitActivityFilterBox_SelectionChanged">
                                                <ComboBoxItem Content="All" />
                                                <ComboBoxItem Content="Issues" />
                                                <ComboBoxItem Content="Risk" />
                                                <ComboBoxItem Content="Commands" />
                                                <ComboBoxItem Content="Jobs" />
                                                <ComboBoxItem Content="Signals" />
                                                <ComboBoxItem Content="Positions" />
                                            </ComboBox>
                                            <TextBox
                                                x:Name="CockpitActivitySearchBox"
                                                Grid.Column="1"
                                                AutomationProperties.Name="Search activity feed"
                                                PlaceholderText="Search activity"
                                                TextChanged="CockpitActivitySearchBox_TextChanged" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                                <ListView
                                    x:Name="CockpitActivityList"
                                    Grid.Row="4"
                                    MinHeight="220"
                                    AutomationProperties.Name="Activity feed"
                                    IsItemClickEnabled="True"
                                    ItemClick="CockpitActivityList_ItemClick"
                                    SelectionMode="Single"
                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                    ScrollViewer.HorizontalScrollMode="Disabled">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0,0,0,6" />
                                            <Setter Property="MinHeight" Value="0" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:MonitoringListItem">
                                            <Border
                                                Padding="10,8"
                                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="2">
                                                        <TextBlock FontSize="13" FontWeight="SemiBold" Text="{x:Bind Title}" TextWrapping="Wrap" />
                                                        <TextBlock FontSize="12" Text="{x:Bind Subtitle}" TextWrapping="Wrap" />
                                                        <TextBlock
                                                            FontSize="11"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="{x:Bind Detail}"
                                                            TextWrapping="Wrap" />
                                                        <TextBlock
                                                            FontSize="10"
