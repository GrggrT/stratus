                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource CockpitCardStyle}">
                            <Grid RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="280" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock x:Name="CockpitChartTitle" FontSize="20" FontWeight="SemiBold" Text="Paper equity and open P&amp;L" />
                                        <TextBlock
                                            x:Name="CockpitChartSubtitle"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="Realised curve when available; otherwise open mark-to-market distribution"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="13" Glyph="&#xE9D2;" />
                                        <TextBlock x:Name="CockpitLegendText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Signals · Fills · Risk" />
                                    </StackPanel>
                                </Grid>
                                <Canvas
                                    x:Name="CockpitChartCanvas"
                                    Grid.Row="1"
                                    AutomationProperties.Name="Interactive cockpit chart"
                                    Background="Transparent"
                                    PointerEntered="CockpitChartCanvas_PointerMoved"
                                    PointerExited="CockpitChartCanvas_PointerExited"
                                    PointerMoved="CockpitChartCanvas_PointerMoved"
                                    SizeChanged="CockpitChartCanvas_SizeChanged" />
                                <TextBlock
                                    x:Name="ActivityText"
                                    Grid.Row="2"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Waiting for monitoring data"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource CockpitCardStyle}">
                            <StackPanel Spacing="12">
                                <StackPanel>
                                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Selected context" />
                                    <TextBlock
                                        x:Name="CockpitDetailHint"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Click a scanner row to inspect the signal or position."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <Border
                                    x:Name="CockpitDetailStatusBadge"
                                    Padding="10,4"
                                    HorizontalAlignment="Left"
                                    Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                                    CornerRadius="10">
                                    <TextBlock x:Name="CockpitDetailStatusTag" FontSize="12" Text="Idle" />
                                </Border>
                                <TextBlock x:Name="CockpitDetailTitle" FontSize="20" FontWeight="SemiBold" Text="No selection" TextWrapping="Wrap" />
                                <TextBlock x:Name="CockpitDetailPrimary" FontSize="15" Text="Select a market signal, open position, or risk event." TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="CockpitDetailSecondary"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="The panel will show model-vs-market context, sizing, P&amp;L, and skip rationale."
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="CockpitDetailMeta"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="No market selected"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource CockpitCardStyle}">
                            <Grid RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="360" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Opportunity scanner" />
                                        <TextBlock
                                            x:Name="CockpitScannerSubtitle"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="Recent signal edges and active mark-to-market positions"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock
                                        x:Name="UpdatedStatusText"
                                        HorizontalAlignment="Right"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="No successful refresh yet" />
                                </Grid>
                                <ListView
                                    x:Name="CockpitScannerList"
                                    Grid.Row="1"
                                    IsItemClickEnabled="True"
                                    ItemClick="CockpitScannerList_ItemClick"
                                    SelectionMode="Single"
                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                    ScrollViewer.HorizontalScrollMode="Disabled">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0,0,0,6" />
                                            <Setter Property="MinHeight" Value="0" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:MonitoringListItem">
                                            <Border
                                                Padding="12,9"
                                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="2">
                                                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="{x:Bind Title}" TextWrapping="Wrap" />
                                                        <TextBlock FontSize="12" Text="{x:Bind Subtitle}" TextWrapping="Wrap" />
                                                        <TextBlock
                                                            FontSize="12"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="{x:Bind Detail}"
                                                            TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <Border
                                                        Grid.Column="1"
                                                        Padding="8,2"
                                                        VerticalAlignment="Top"
                                                        Background="{x:Bind Accent, Converter={StaticResource AccentToBrush}}"
                                                        CornerRadius="10">
                                                        <TextBlock FontSize="11" Text="{x:Bind Status}" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CockpitCardStyle}">
                            <Grid RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="Risk rail" />
                                <StackPanel Grid.Row="1" Spacing="6">
                                    <TextBlock x:Name="ApiStatusText" FontSize="16" FontWeight="SemiBold" Text="Connecting" />
                                    <TextBlock x:Name="ApiDetailText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Waiting for health checks" TextWrapping="Wrap" />
                                    <TextBlock x:Name="CockpitRiskRuntime" Text="Runtime state unavailable" TextWrapping="Wrap" />
                                    <TextBlock x:Name="CockpitRiskHealth" Text="Health audit unavailable" TextWrapping="Wrap" />
                                    <TextBlock x:Name="CockpitRiskActivity" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="No recent activity" TextWrapping="Wrap" />
                                </StackPanel>
                                <Rectangle Grid.Row="2" Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                                <Grid Grid.Row="3">
                                    <StackPanel Spacing="8">
                                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Activity feed" />
                                        <TextBlock
                                            x:Name="CockpitActivitySubtitle"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="Latest commands, jobs, signals, and position changes"
                                            TextWrapping="Wrap" />
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox
                                                x:Name="CockpitActivityFilterBox"
                                                AutomationProperties.Name="Activity feed category"
                                                SelectedIndex="0"
                                                SelectionChanged="CockpitActivityFilterBox_SelectionChanged">
                                                <ComboBoxItem Content="All" />
                                                <ComboBoxItem Content="Issues" />
                                                <ComboBoxItem Content="Risk" />
                                                <ComboBoxItem Content="Commands" />
                                                <ComboBoxItem Content="Jobs" />
                                                <ComboBoxItem Content="Signals" />
                                                <ComboBoxItem Content="Positions" />
                                            </ComboBox>
                                            <TextBox
                                                x:Name="CockpitActivitySearchBox"
                                                Grid.Column="1"
                                                AutomationProperties.Name="Search activity feed"
                                                PlaceholderText="Search activity"
                                                TextChanged="CockpitActivitySearchBox_TextChanged" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                                <ListView
                                    x:Name="CockpitActivityList"
                                    Grid.Row="4"
                                    MinHeight="220"
                                    AutomationProperties.Name="Activity feed"
                                    IsItemClickEnabled="True"
                                    ItemClick="CockpitActivityList_ItemClick"
                                    SelectionMode="Single"
                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                    ScrollViewer.HorizontalScrollMode="Disabled">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0,0,0,6" />
                                            <Setter Property="MinHeight" Value="0" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:MonitoringListItem">
                                            <Border
                                                Padding="10,8"
                                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="2">
                                                        <TextBlock FontSize="13" FontWeight="SemiBold" Text="{x:Bind Title}" TextWrapping="Wrap" />
                                                        <TextBlock FontSize="12" Text="{x:Bind Subtitle}" TextWrapping="Wrap" />
                                                        <TextBlock
                                                            FontSize="11"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="{x:Bind Detail}"
                                                            TextWrapping="Wrap" />
                                                        <TextBlock
                                                            FontSize="10"
                                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                            Text="{x:Bind Meta}"
                                                            TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <Border
                                                        Grid.Column="1"
                                                        Padding="7,2"
                                                        VerticalAlignment="Top"
                                                        Background="{x:Bind Accent, Converter={StaticResource AccentToBrush}}"
                                                        CornerRadius="8">
                                                        <TextBlock FontSize="10" Text="{x:Bind Status}" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <Grid
                x:Name="AlertsView"
                Grid.Row="2"
                MaxWidth="1500"
                HorizontalAlignment="Left"
                Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <InfoBar
                    x:Name="AlertsInfoBar"
                    Margin="32,0,32,12"
                    IsClosable="True"
                    IsOpen="False"
                    Message="Alert inbox status"
                    Severity="Informational"
                    Title="Alerts" />

                <Grid
                    x:Name="AlertsSummaryGrid"
                    Grid.Row="1"
                    Margin="32,0,32,16"
                    ColumnSpacing="12"
                    RowSpacing="12">
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="AlertsSummaryLayoutStates">
                            <VisualState x:Name="AlertsSummaryCompact" />
                            <VisualState x:Name="AlertsSummaryWide">
                                <VisualState.StateTriggers>
                                    <AdaptiveTrigger MinWindowWidth="1180" />
                                </VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Target="AlertsSummaryColumn1.Width" Value="*" />
                                    <Setter Target="AlertsSummaryColumn2.Width" Value="*" />
                                    <Setter Target="AlertsChannelCard.(Grid.Row)" Value="0" />
                                    <Setter Target="AlertsChannelCard.(Grid.Column)" Value="1" />
                                    <Setter Target="AlertsDeliveryCard.(Grid.Row)" Value="0" />
                                    <Setter Target="AlertsDeliveryCard.(Grid.Column)" Value="2" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="AlertsSummaryColumn1" Width="0" />
                        <ColumnDefinition x:Name="AlertsSummaryColumn2" Width="0" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource CockpitCardStyle}">
                        <StackPanel Spacing="7">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Local inbox" />
                            <TextBlock
                                x:Name="AlertsUnacknowledgedText"
                                AutomationProperties.LiveSetting="Polite"
                                FontSize="22"
                                FontWeight="SemiBold"
                                Text="Loading..." />
                            <TextBlock
                                x:Name="AlertsLocalDetailText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Fetching durable local alert records"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="AlertsLocalFreshnessText"
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="Snapshot unavailable"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border
                        x:Name="AlertsChannelCard"
                        Grid.Row="1"
                        Style="{StaticResource CockpitCardStyle}">
                        <StackPanel Spacing="7">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Optional Telegram delivery" />
                                <Border
                                    x:Name="AlertsChannelBadge"
                                    Grid.Column="1"
                                    Padding="8,2"
                                    Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                                    CornerRadius="8">
                                    <TextBlock
                                        x:Name="AlertsChannelBadgeText"
                                        FontSize="11"
                                        Text="Checking" />
                                </Border>
                            </Grid>
                            <TextBlock
                                x:Name="AlertsChannelStatusText"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Text="Loading..." />
                            <TextBlock
                                x:Name="AlertsChannelDetailText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Telegram is optional; the local inbox works independently"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="AlertsHeartbeatText"
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="Activation and heartbeat unavailable"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border
                        x:Name="AlertsDeliveryCard"
                        Grid.Row="2"
                        Style="{StaticResource CockpitCardStyle}">
                        <StackPanel Spacing="7">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="External delivery queue" />
                                <Border
                                    x:Name="AlertsBacklogBadge"
                                    Grid.Column="1"
                                    Padding="8,2"
                                    Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                                    CornerRadius="8">
                                    <TextBlock
                                        x:Name="AlertsBacklogBadgeText"
                                        FontSize="11"
                                        Text="Checking" />
                                </Border>
                            </Grid>
                            <TextBlock
                                x:Name="AlertsBacklogText"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Text="Loading..." />
                            <TextBlock
                                x:Name="AlertsBacklogDetailText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Pending and dead-letter delivery state"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="AlertsDeliveryErrorText"
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="No delivery error reported"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="2">
                    <ListView
                        x:Name="AlertsList"
                        Padding="32,0,32,32"
                        AutomationProperties.Name="Local alert inbox"
                        SelectionMode="None"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.HorizontalScrollMode="Disabled">
                        <ListView.Header>
                            <Grid Margin="2,0,2,10" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Durable local inbox" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Acknowledgement is local. It never changes Telegram send or retry state."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock
                                    x:Name="AlertsListHeaderText"
                                    Grid.Column="1"
                                    VerticalAlignment="Top"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="0 shown" />
                            </Grid>
                        </ListView.Header>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,8" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:AlertInboxListItem">
                                <Border
                                    Padding="16,13"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="9">
                                    <Grid ColumnSpacing="14" RowSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock
                                                FontSize="15"
                                                FontWeight="SemiBold"
                                                Text="{x:Bind Title}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                FontFamily="Consolas"
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                Text="{x:Bind EventKey}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="1"
                                            MinWidth="112"
                                            VerticalAlignment="Top"
                                            AutomationProperties.HelpText="{x:Bind EventKey}"
                                            Click="AlertAckButton_Click"
                                            Content="{x:Bind AcknowledgeLabel}"
                                            IsEnabled="{x:Bind CanAcknowledge}"
                                            Tag="{x:Bind Id}" />
                                        <TextBlock
                                            Grid.Row="1"
                                            Grid.ColumnSpan="2"
                                            FontFamily="Consolas"
                                            FontSize="12"
                                            Text="{x:Bind Payload}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Grid.Row="2"
                                            Grid.ColumnSpan="2"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind LocalState}"
                                            TextWrapping="Wrap" />
                                        <Grid Grid.Row="3" Grid.ColumnSpan="2" ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border
                                                Padding="8,2"
                                                VerticalAlignment="Top"
                                                Background="{x:Bind Accent, Converter={StaticResource AccentToBrush}}"
                                                CornerRadius="8">
                                                <TextBlock FontSize="11" Text="{x:Bind Status}" />
                                            </Border>
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind ExternalState}"
                                                TextWrapping="Wrap" />
                                        </Grid>
                                        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Spacing="2">
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                Text="{x:Bind Created}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                Text="{x:Bind DeliveryDetail}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                Text="{x:Bind ErrorDetail}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel
                        x:Name="AlertsEmptyState"
                        MaxWidth="560"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False"
                        Spacing="10">
                        <FontIcon FontSize="38" Glyph="&#xE73E;" />
                        <TextBlock
                            x:Name="AlertsEmptyText"
                            FontSize="18"
                            Text="No unacknowledged local alerts"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="AlertsEmptyDetailText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="The inbox is clear. Telegram activation is optional."
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Cap the content column and align it left with the header so
                 single-row cards don't stretch into sparse full-width strips
                 on wide monitors. -->
            <Grid
                x:Name="CollectionView"
                Grid.Row="2"
                MaxWidth="1500"
                HorizontalAlignment="Left"
                Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="CollectionDetailColumn" Width="0" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border
                    x:Name="ControlRoomPanel"
                    Grid.Row="0"
                    Grid.ColumnSpan="2"
                    Margin="32,0,32,12"
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Visibility="Collapsed">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="ControlRoomTitle" FontSize="18" FontWeight="SemiBold" Text="Risk &amp; Live control room" />
                            <TextBlock
                                x:Name="ControlRoomSubtitle"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Runtime, live readiness, command audit, and live monitor"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Grid Grid.Row="1" ColumnSpacing="12" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border
                                Padding="12"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <StackPanel Spacing="8">
                                    <TextBlock FontWeight="SemiBold" Text="Runtime state" />
                                    <TextBlock x:Name="ControlRoomRuntimeText" FontSize="22" FontWeight="SemiBold" Text="Unknown" />
                                    <TextBlock
                                        x:Name="ControlRoomRuntimeDetailText"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Runtime data unavailable"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border
                                Grid.Column="1"
                                Padding="12"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <StackPanel Spacing="8">
                                    <TextBlock FontWeight="SemiBold" Text="Live readiness" />
                                    <TextBlock
                                        x:Name="ControlRoomReadinessText"
                                        FontFamily="Consolas"
