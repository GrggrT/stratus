# Also used by docker-compose for the postgres and backup containers.
# Set a real value on any shared host and keep DATABASE_URL in sync.
POSTGRES_PASSWORD=stratus
DATABASE_URL=postgresql+asyncpg://stratus:stratus@localhost:5432/stratus
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_FORECAST_DAYS=10
OPEN_METEO_CONCURRENCY=4
FORECAST_MODELS=ecmwf,gfs,icon,gem
OPEN_METEO_ENSEMBLE_URL=https://ensemble-api.open-meteo.com/v1/ensemble
OPEN_METEO_ENSEMBLE_FORECAST_DAYS=10
OPEN_METEO_ENSEMBLE_CONCURRENCY=2
ENSEMBLE_MODELS=gefs,ecmwf_ens
GAMMA_EVENTS_URL=https://gamma-api.polymarket.com/events
GAMMA_WEATHER_TAG_ID=84
TARGET_CITIES=New York City,London,Paris
AVIATION_WEATHER_METAR_URL=https://aviationweather.gov/api/data/metar
AVIATION_WEATHER_USER_AGENT=STRATUS/0.1
NWS_BASE_URL=https://api.weather.gov
NWS_USER_AGENT=STRATUS/0.1 weather research
NWS_STATIONS=KLGA
OBSERVATION_LOOKBACK_HOURS=6
CLOB_BOOKS_URL=https://clob.polymarket.com/books
CLOB_BATCH_SIZE=50
IEM_ASOS_URL=https://mesonet.agron.iastate.edu/cgi-bin/request/asos.py
IEM_BOOTSTRAP_YEARS=3
IEM_REQUEST_DELAY_SECONDS=12
OPEN_METEO_PREVIOUS_RUNS_URL=https://previous-runs-api.open-meteo.com/v1/forecast
PREVIOUS_RUNS_BOOTSTRAP_YEARS=3
PREVIOUS_RUN_HORIZON_DAYS=1,2,3
PREVIOUS_RUNS_CONCURRENCY=2
CALIBRATION_WINDOW_DAYS=180
CALIBRATION_MIN_SAMPLES=60
INITIAL_BANKROLL_USD=1080
# Accounting timezone for daily/weekly loss limits; America/New_York aligns
# the reset with the venue day.
RISK_TIMEZONE=America/New_York
SIGNAL_RETENTION_DAYS=30
TRADING_MODE=paper
# TELEGRAM_BOT_TOKEN=123456:replace-me
# TELEGRAM_ADMIN_USER_ID=123456789
# TELEGRAM_CHAT_ID=123456789
# Off-site backups (docker compose --profile offsite): rclone remote target
# and the path to a configured rclone.conf (gitignored).
# OFFSITE_REMOTE=s3:my-bucket/stratus-backups
# RCLONE_CONFIG_FILE=./rclone.conf
# The operator's personal sign-off for live trading (see
# docs/AUSTRIA_LIVE_READINESS.md). The runtime never flips these.
LIVE_LEGAL_APPROVED=false
LIVE_TAX_APPROVED=false
# --- Live executor (Polymarket CLOB) ---
CLOB_API_URL=https://clob.polymarket.com
GEOBLOCK_URL=https://polymarket.com/api/geoblock
POLYGON_CHAIN_ID=137
# Polygon wallet key that signs orders. Treat this file as a secret once set.
# POLYGON_PRIVATE_KEY=0x...
# For Polymarket proxy wallets set both; leave unset for a plain EOA.
# POLYMARKET_FUNDER=0x...
# POLYMARKET_SIGNATURE_TYPE=1
# Hard per-order ceiling in USD, independent of Kelly/exposure limits.
LIVE_MAX_ORDER_USD=25
API_HOST=0.0.0.0
API_PORT=8000
# Required before exposing the API beyond loopback; the operator console
# sends it as X-API-Key (reads STRATUS_OPERATOR_API_KEY from its env).
# OPERATOR_API_KEY=change-me
LOG_LEVEL=INFO
